menu "Hardware test (hwtest)"

    config RETRO_HWTEST_BOOT
        bool "Boot into the hardware test"
        default n
        help
            Start the Phase 1 bring-up tests instead of the Phase 2
            pipeline test (synthetic core). Later this becomes Recovery ->
            "Test hardware".

    config RETRO_HWTEST_AUTORUN
        bool "Run the automatic tests at boot"
        depends on RETRO_HWTEST_BOOT
        default y
        help
            Runs "all" once at boot: board, display, PPA, SD, audio, power,
            RTC, then starts the USB host. Plays short test tones.

endmenu
