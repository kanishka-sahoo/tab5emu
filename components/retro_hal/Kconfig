menu "Retro HAL"

    config RETRO_LOG_RING_SIZE
        int "In-RAM log ring size (bytes)"
        range 1024 262144
        default 16384
        help
            Size of the circular log kept in internal RAM for the recovery
            log viewer (spec §46).

    config RETRO_LOG_DEFAULT_LEVEL
        int "Default log level (0=none 1=error 2=warn 3=info 4=debug 5=verbose)"
        range 0 5
        default 3

    config RETRO_LOG_CAPTURE_IDF
        bool "Capture ESP-IDF log output in the in-RAM ring"
        default y
        help
            Tee ESP_LOGx output (drivers, BSP) into the log ring so recovery
            mode shows it alongside RetroHAL messages.

    config RETRO_TAB5_SHUNT_MOHM
        int "Tab5 battery shunt resistor (milliohm)"
        range 1 1000
        default 5
        help
            Shunt on the INA226 battery monitor. M5Unified uses 5 mOhm for
            the Tab5.

    config RETRO_TAB5_DISPLAY_60HZ
        bool "Retime the Tab5 panel to 60 Hz"
        default y
        help
            The BSP's ST7123/ST7121 timings refresh at 57.5 Hz (bring-up),
            which drops ~2.6 frames a second of 60 Hz content. This shortens
            the vertical front porch so the panel runs at 60.0 Hz. The
            original ILI9881C panel keeps the BSP timing.

    config RETRO_TAB5_TOUCH_I2C_KHZ
        int "ST712x touch I2C clock (kHz)"
        range 100 400
        default 400
        help
            Clock for reading the ST7123/ST7121 touch controller directly.
            Falls back to 100 kHz if the controller doesn't answer.

    choice RETRO_TAB5_LANDSCAPE
        prompt "Tab5 landscape orientation"
        default RETRO_TAB5_LANDSCAPE_CW
        help
            The panel scans out in portrait (720x1280, plan D2). This picks
            which way landscape content is rotated onto it. CW puts the top
            of the landscape image on the panel's native right edge.

        config RETRO_TAB5_LANDSCAPE_CW
            bool "Rotate 90 degrees clockwise"
        config RETRO_TAB5_LANDSCAPE_CCW
            bool "Rotate 90 degrees counter-clockwise"
    endchoice

endmenu
